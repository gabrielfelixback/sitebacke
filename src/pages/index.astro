---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Clients from '../components/Clients.astro';
import Cost from '../components/Cost.astro';
import Reel from '../components/Reel.astro';
import Band from '../components/Band.astro';
import Services from '../components/Services.astro';
import Differentials from '../components/Differentials.astro';
import Proof from '../components/Proof.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import Consent from '../components/Consent.astro';
---
<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <Clients />
    <Cost />
    <Band words={['Estratégia', 'Criatividade', 'Performance']} />
    <Reel />
    <Services />
    <Band words={['Marca', 'Demanda', 'Imagem']} reverse />
    <Differentials />
    <Proof />
    <Process />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <MobileCta />
  <Consent />
  <script>
    import '../scripts/ui';
    import '../scripts/form';
    import '../scripts/motion';
  </script>
</Base>
