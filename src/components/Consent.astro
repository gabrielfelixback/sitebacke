---
import { asset } from '../lib/url';
---
<div class="consent" data-consent hidden role="dialog" aria-modal="false" aria-labelledby="consent-title">
  <p class="consent__t" id="consent-title">Privacidade e medição</p>
  <p class="consent__p">
    Usamos o Meta Pixel para medir campanhas, só com a sua permissão. <a href={asset('privacidade.html')}>Política de Privacidade</a>.
  </p>
  <div class="consent__a">
    <button type="button" class="consent__no" data-consent-choice="rejected">Recusar</button>
    <button type="button" class="consent__yes" data-consent-choice="accepted">Aceitar</button>
  </div>
</div>

<style>
  .consent {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 60;
    width: min(360px, calc(100vw - 32px));
    padding: 18px;
    border-radius: 20px;
    background: rgb(20 19 18 / 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: inset 0 0 0 1px var(--line-strong), 0 30px 80px -20px rgb(0 0 0 / 0.8);
    animation: consent-in 0.7s var(--ease-out) both;
  }
  @media (max-width: 600px) {
    .consent {
      left: 10px;
      right: 10px;
      width: auto;
      bottom: calc(10px + env(safe-area-inset-bottom));
      padding: 14px 16px;
      border-radius: 16px;
    }
    .consent__t {
      display: none;
    }
    .consent__p {
      margin: 0;
      font-size: 0.8rem;
    }
    .consent__a {
      margin-top: 10px;
    }
    .consent__a button {
      height: 40px;
      flex: 1;
    }
  }
  .consent[hidden] {
    display: none;
  }
  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  .consent__t {
    font-weight: 600;
  }
  .consent__p {
    margin-top: 6px;
    font-size: 0.86rem;
    color: var(--mute);
    line-height: 1.5;
  }
  .consent__p a {
    color: var(--text);
  }
  .consent__a {
    margin-top: 14px;
    display: flex;
    gap: 8px;
    justify-content: flex-end;
  }
  .consent__a button {
    height: 42px;
    padding: 0 18px;
    border-radius: 999px;
    border: 0;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .consent__no {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .consent__yes {
    background: var(--orange);
    color: var(--black);
  }
</style>
