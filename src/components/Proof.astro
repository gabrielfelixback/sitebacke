---
import { STATS } from '../data/content';
import Symbol from './Symbol.astro';
const fmt = (v: number, d: number) => v.toLocaleString('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d }).replace(',', '.');
---
<section class="proof section" id="resultados" aria-labelledby="proof-title">
  <div class="proof__bg" aria-hidden="true">
    <Symbol class="proof__sym" />
  </div>
  <div class="wrap">
    <div class="proof__head">
      <p class="eyebrow" data-reveal>Resultados</p>
      <h2 class="h2 proof__title" id="proof-title" data-reveal>
        Números que a gente assina embaixo.
      </h2>
    </div>
    <ul class="proof__stats">
      {
        STATS.map((s, i) => (
          <li data-reveal style={`--d:${i * 0.08}s`}>
            <p class="proof__num"><span class="sr-only">{`${s.prefix}${fmt(s.value, s.decimals)}${s.suffix}`}</span>
              <span aria-hidden="true"><span class="proof__pre">{s.prefix}</span><span data-count={s.value} data-decimals={s.decimals}>{fmt(s.value, s.decimals)}</span><span class="proof__suf">{s.suffix}</span></span>
            </p>
            <p class="proof__label">{s.label}</p>
          </li>
        ))
      }
    </ul>

    <!-- Caso real enviado pela Backe (print do Gerenciador de Anúncios da Meta, 24 campanhas). Cliente não identificado. -->
    <article class="case" data-reveal aria-labelledby="case-title">
      <div class="case__copy">
        <p class="case__tag"><span aria-hidden="true"></span>Caso real · Meta Ads · 24 campanhas de vendas</p>
        <h3 class="case__title" id="case-title">R$ 35,9 mil em mídia. R$ 310,9 mil em vendas.</h3>
        <p class="case__p">
          Números de um cliente da Backe, tirados direto do gerenciador de anúncios: cada real investido voltou quase nove
          vezes em compras no site.
        </p>
        <a class="link-arrow" href="#diagnostico" data-cta="case">
          Quero um plano assim para a minha empresa
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
      <div class="report" aria-label="Resumo do resultado">
        <div class="report__bars" aria-hidden="true">
          <div class="bar bar--in"><span>Investido</span><i style="--w:11.55%"></i></div>
          <div class="bar bar--out"><span>Retorno em vendas</span><i style="--w:100%"></i></div>
        </div>
        <dl class="report__grid">
          <div><dt>Valor investido</dt><dd>R$ 35.906,90</dd></div>
          <div><dt>Valor de conversão</dt><dd>R$ 310.935,90</dd></div>
          <div><dt>Compras no site</dt><dd>2.691</dd></div>
          <div class="report__hl"><dt>Retorno sobre o investimento</dt><dd>8,7x</dd></div>
        </dl>
      </div>
    </article>
  </div>
</section>

<style>
  .proof {
    position: relative;
    background: var(--black);
    overflow: hidden;
  }
  .case {
    position: relative;
    margin-top: clamp(4rem, 8vw, 6rem);
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(28px, 4vw, 64px);
    padding: clamp(28px, 4vw, 56px);
    border-radius: 36px;
    background:
      radial-gradient(60% 80% at 100% 100%, rgb(254 67 77 / 0.2), transparent 60%),
      linear-gradient(160deg, #1b1918, #0e0d0c 70%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }
  .case__copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }
  .case__tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--mute);
  }
  .case__tag span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #25d366;
    box-shadow: 0 0 0 4px rgb(37 211 102 / 0.15);
  }
  .case__title {
    font-family: var(--f-display);
    font-size: clamp(2rem, 3.8vw, 3.6rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .case__p {
    color: var(--mute);
    max-width: 40ch;
  }
  .case .link-arrow {
    margin-top: auto;
  }
  .report {
    display: grid;
    gap: 28px;
    padding: 28px;
    border-radius: 24px;
    background: rgb(0 0 0 / 0.35);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .report__bars {
    display: grid;
    gap: 14px;
  }
  .bar span {
    display: block;
    font-size: 0.82rem;
    color: var(--mute);
    margin-bottom: 6px;
  }
  .bar i {
    display: block;
    height: 14px;
    border-radius: 999px;
    width: var(--w);
    transform-origin: left;
    background: rgb(255 255 255 / 0.25);
  }
  .bar--out i {
    height: 22px;
    background: linear-gradient(90deg, var(--sun-1), var(--sun-2) 55%, var(--sun-3));
    box-shadow: 0 0 40px rgb(254 67 77 / 0.35);
  }
  :global(.js) .case .bar i {
    transform: scaleX(0);
    transition: transform 1.8s var(--ease-out) 0.3s;
  }
  :global(.js) .case.is-in .bar i {
    transform: none;
  }
  :global(.js) .case.is-in .bar--out i {
    transition-delay: 0.6s;
  }
  .report__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--line);
  }
  .report__grid > div {
    padding: 16px 18px;
    background: #0f0e0d;
  }
  .report__grid dt {
    font-size: 0.8rem;
    color: var(--mute);
  }
  .report__grid dd {
    margin: 6px 0 0;
    font-family: var(--f-display);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .report__hl dd {
    background: var(--sun);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (max-width: 900px) {
    .case {
      grid-template-columns: 1fr;
    }
    .report {
      padding: 18px;
    }
  }
  @media (max-width: 420px) {
    .report__grid {
      grid-template-columns: 1fr;
    }
  }
  .proof__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .proof__sym {
    position: absolute;
    left: -12vw;
    top: 50%;
    width: 54vw;
    max-width: 820px;
    translate: 0 -50%;
    opacity: 0.08;
  }
  .proof__head {
    display: grid;
    gap: 24px;
    max-width: 900px;
    margin-left: auto;
  }
  .proof__stats {
    position: relative;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
  }
  .proof__stats li {
    padding: 32px 24px 0;
  }
  .proof__stats li + li {
    border-left: 1px solid var(--line);
  }
  .proof__stats li:first-child {
    padding-left: 0;
  }
  .proof__num {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(3rem, 6.6vw, 6.4rem);
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .proof__pre,
  .proof__suf {
    background: var(--sun);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .proof__pre {
    font-size: 0.55em;
    vertical-align: 0.6em;
    margin-right: 0.04em;
  }
  .proof__label {
    margin-top: 14px;
    color: var(--mute);
  }
  @media (max-width: 900px) {
    .proof__stats {
      grid-template-columns: 1fr 1fr;
    }
    .proof__stats li:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .proof__stats li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
      margin-top: 32px;
    }
    .proof__stats li {
      padding: 26px 16px 0;
    }
    .proof__stats li:nth-child(odd) {
      padding-left: 0;
    }
  }
</style>
