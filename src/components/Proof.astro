---
import { STATS } from '../data/content';
import Symbol from './Symbol.astro';
import { asset } from '../lib/url';
const fmt = (v: number, d: number) => v.toLocaleString('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d }).replace(',', '.');
---
<section class="proof section" id="resultados" aria-labelledby="proof-title">
  <div class="proof__bg" aria-hidden="true">
    <Symbol class="proof__sym" />
  </div>
  <div class="wrap">
    <div class="proof__head">
      <p class="eyebrow" data-reveal>Resultados</p>
      <h2 class="h2 proof__title" id="proof-title" data-reveal>
        Números que a gente <em class="hl">assina</em> embaixo.
      </h2>
    </div>
    <ul class="proof__stats">
      {
        STATS.map((s, i) => (
          <li data-reveal style={`--d:${i * 0.08}s`}>
            <p class="proof__num"><span class="sr-only">{`${s.prefix}${fmt(s.value, s.decimals)}${s.suffix}`}</span>
              <span aria-hidden="true"><span class="proof__pre">{s.prefix}</span><span data-count={s.value} data-decimals={s.decimals}>{fmt(s.value, s.decimals)}</span><span class="proof__suf">{s.suffix}</span></span>
            </p>
            <p class="proof__label">{s.label}</p>
          </li>
        ))
      }
    </ul>

    <!-- Caso real enviado pela Backe (print do Gerenciador de Anúncios da Meta, 24 campanhas). Cliente não identificado. -->
    <article class="case" data-reveal aria-labelledby="case-title">
      <div class="case__copy">
        <p class="case__tag"><span aria-hidden="true"></span>Caso real em Meta Ads, com 24 campanhas de vendas</p>
        <h3 class="case__title" id="case-title">R$ 35,9 mil em mídia. R$ 310,9 mil em vendas.</h3>
        <p class="case__p">
          Números de um cliente da Backe, tirados direto do gerenciador de anúncios: cada real investido voltou quase nove
          vezes em compras no site.
        </p>
        <a class="link-arrow" href="#diagnostico" data-cta="case">
          Quero um plano assim para a minha empresa
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
      <div class="report" aria-label="Resumo do resultado">
        <div class="report__bars" aria-hidden="true">
          <div class="bar bar--in"><span>Investido</span><i style="--w:11.55%"></i></div>
          <div class="bar bar--out"><span>Retorno em vendas</span><i style="--w:100%"></i></div>
        </div>
        <dl class="report__grid">
          <div><dt>Valor investido</dt><dd>R$ 35.906,90</dd></div>
          <div><dt>Valor de conversão</dt><dd>R$ 310.935,90</dd></div>
          <div><dt>Compras no site</dt><dd>2.691</dd></div>
          <div class="report__hl"><dt>Retorno sobre o investimento</dt><dd>8,7x</dd></div>
        </dl>
      </div>
      <figure class="print">
        <button class="print__btn" type="button" data-lightbox={asset('cases/vendas-meta-ads.webp')} data-lightbox-alt="Print do Gerenciador de Anúncios da Meta: resultados de 24 campanhas, com R$ 35.906,90 investidos, 2.691 compras e R$ 310.935,90 em valor de conversão.">
          <span class="print__bar" aria-hidden="true"><i></i><i></i><i></i><span>Print original do Gerenciador de Anúncios</span></span>
          <img src={asset('cases/vendas-meta-ads.webp')} alt="Print do Gerenciador de Anúncios da Meta: resultados de 24 campanhas, com R$ 35.906,90 investidos, 2.691 compras e R$ 310.935,90 em valor de conversão." width="2000" height="1071" loading="lazy" decoding="async" />
          <span class="print__zoom">Ampliar print</span>
        </button>
      </figure>
    </article>

    <!-- Caso real enviado pela Backe (print do Gerenciador de Anúncios: perfil criado do zero, 2 meses). Cliente não identificado. -->
    <article class="case case--alt" data-reveal aria-labelledby="case2-title">
      <div class="case__copy">
        <p class="case__tag"><span aria-hidden="true"></span>Caso real no Instagram, com um perfil criado do zero</p>
        <h3 class="case__title" id="case2-title">Do zero a 3.574 seguidores em dois meses.</h3>
        <p class="case__p">
          Um perfil novo, sem audiência nenhuma: em dois meses foram 17.819 visitas ao perfil e mais de 20 mil cliques, a
          R$ 0,22 cada.
        </p>
        <a class="link-arrow" href="#diagnostico" data-interest="Gestão de Redes Sociais" data-cta="case-instagram">
          Quero construir a audiência da minha marca
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
      <div class="report" aria-label="Resumo do resultado">
        <div class="follow" aria-hidden="true">
          <span class="follow__from">0</span>
          <span class="follow__line"><i></i></span>
          <span class="follow__to"><b data-count="3574" data-decimals="0">3.574</b> seguidores</span>
        </div>
        <dl class="report__grid">
          <div><dt>Visitas ao perfil</dt><dd>17.819</dd></div>
          <div><dt>Cliques</dt><dd>20.531</dd></div>
          <div><dt>Taxa de cliques (CTR)</dt><dd>4,63%</dd></div>
          <div class="report__hl"><dt>Custo por clique</dt><dd>R$ 0,22</dd></div>
        </dl>
      </div>
      <figure class="print">
        <button class="print__btn" type="button" data-lightbox={asset('cases/instagram-meta-ads.webp')} data-lightbox-alt="Print do Gerenciador de Anúncios da Meta: 20.531 cliques, CTR de 4,63%, CPC de R$ 0,22, 17.819 visitas ao perfil e 3.574 seguidores no Instagram.">
          <span class="print__bar" aria-hidden="true"><i></i><i></i><i></i><span>Print original do Gerenciador de Anúncios</span></span>
          <img src={asset('cases/instagram-meta-ads.webp')} alt="Print do Gerenciador de Anúncios da Meta: 20.531 cliques, CTR de 4,63%, CPC de R$ 0,22, 17.819 visitas ao perfil e 3.574 seguidores no Instagram." width="1576" height="500" loading="lazy" decoding="async" />
          <span class="print__zoom">Ampliar print</span>
        </button>
      </figure>
    </article>

    <dialog class="lightbox" data-lightbox-dialog aria-label="Print ampliado">
      <img alt="" data-lightbox-img />
      <form method="dialog"><button class="lightbox__close" type="submit">Fechar</button></form>
    </dialog>
  </div>
</section>

<style>
  .proof {
    position: relative;
    background: var(--black);
    overflow: hidden;
  }
  .case {
    position: relative;
    margin-top: clamp(4rem, 8vw, 6rem);
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(28px, 4vw, 64px);
    padding: clamp(28px, 4vw, 56px);
    border-radius: 36px;
    background:
      radial-gradient(60% 80% at 100% 100%, rgb(254 67 77 / 0.2), transparent 60%),
      linear-gradient(160deg, #1b1918, #0e0d0c 70%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }
  .case__copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }
  .case__tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--mute);
  }
  .case__tag span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #25d366;
    box-shadow: 0 0 0 4px rgb(37 211 102 / 0.15);
  }
  .case__title {
    font-family: var(--f-display);
    font-size: clamp(2rem, 3.8vw, 3.6rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .case__p {
    color: var(--mute);
    max-width: 40ch;
  }
  .case .link-arrow {
    margin-top: auto;
  }
  .report {
    display: grid;
    gap: 28px;
    padding: 28px;
    border-radius: 24px;
    background: rgb(0 0 0 / 0.35);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .report__bars {
    display: grid;
    gap: 14px;
  }
  .bar span {
    display: block;
    font-size: 0.82rem;
    color: var(--mute);
    margin-bottom: 6px;
  }
  .bar i {
    display: block;
    height: 14px;
    border-radius: 999px;
    width: var(--w);
    transform-origin: left;
    background: rgb(255 255 255 / 0.25);
  }
  .bar--out i {
    height: 22px;
    background: linear-gradient(90deg, var(--sun-1), var(--sun-2) 55%, var(--sun-3));
    box-shadow: 0 0 40px rgb(254 67 77 / 0.35);
  }
  :global(.js) .case .bar i {
    transform: scaleX(0);
    transition: transform 1.8s var(--ease-out) 0.3s;
  }
  :global(.js) .case.is-in .bar i {
    transform: none;
  }
  :global(.js) .case.is-in .bar--out i {
    transition-delay: 0.6s;
  }
  .report__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--line);
  }
  .report__grid > div {
    padding: 16px 18px;
    background: #0f0e0d;
  }
  .report__grid dt {
    font-size: 0.8rem;
    color: var(--mute);
  }
  .report__grid dd {
    margin: 6px 0 0;
    font-family: var(--f-display);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .report__hl dd {
    background: var(--sun);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .case--alt {
    margin-top: 24px;
    grid-template-columns: 1.1fr 1fr;
    background:
      radial-gradient(60% 80% at 0% 100%, rgb(241 143 52 / 0.18), transparent 60%),
      linear-gradient(200deg, #1b1918, #0e0d0c 70%);
  }
  .case--alt .report {
    order: -1;
  }
  /* print original do gerenciador: prova, não decoração */
  .print {
    grid-column: 1 / -1;
    justify-self: center;
    width: min(100%, 760px);
    margin: 0;
  }
  .print__btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    background: #fff;
    text-align: left;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.9), 0 0 0 1px rgb(255 255 255 / 0.08);
    cursor: zoom-in;
    transition: transform 0.6s var(--ease-out), box-shadow 0.6s;
  }
  .print__btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 40px 90px -30px rgb(254 67 77 / 0.35), 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .print__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: #f1f1f1;
    border-bottom: 1px solid #e3e3e3;
    font-size: 0.78rem;
    color: #6b6b6b;
  }
  .print__bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d4d4d4;
  }
  .print__bar span {
    margin-left: 8px;
  }
  .print__btn img {
    width: 100%;
    height: auto;
  }
  .print__zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.75);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s, transform 0.4s var(--ease-out);
  }
  .print__btn:hover .print__zoom,
  .print__btn:focus-visible .print__zoom {
    opacity: 1;
    transform: none;
  }
  .lightbox {
    max-width: min(1400px, 94vw);
    max-height: calc(var(--vh, 1svh) * 90);
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: #fff;
    overflow: auto;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
    backdrop-filter: blur(6px);
  }
  .lightbox img {
    display: block;
    width: 100%;
    height: auto;
  }
  .lightbox form {
    position: sticky;
    bottom: 0;
    display: flex;
    justify-content: flex-end;
    padding: 12px;
    background: linear-gradient(transparent, rgb(255 255 255 / 0.95) 40%);
  }
  .lightbox__close {
    min-height: 44px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-weight: 600;
  }
  .follow {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 6px 0 4px;
  }
  .follow__from {
    font-family: var(--f-display);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--mute);
  }
  .follow__line {
    position: relative;
    height: 2px;
    background: var(--line);
  }
  .follow__line i {
    position: absolute;
    inset: 0;
    background: var(--sun);
    box-shadow: 0 0 20px rgb(254 67 77 / 0.6);
    transform-origin: left;
  }
  .follow__line i::after {
    content: '';
    position: absolute;
    right: -6px;
    top: -5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--sun-3);
    box-shadow: 0 0 0 5px rgb(254 67 77 / 0.2);
  }
  :global(.js) .case .follow__line i {
    transform: scaleX(0);
    transition: transform 1.8s var(--ease-out) 0.3s;
  }
  :global(.js) .case.is-in .follow__line i {
    transform: none;
  }
  .follow__to {
    font-size: 0.9rem;
    color: var(--mute);
    white-space: nowrap;
  }
  .follow__to b {
    display: block;
    font-family: var(--f-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 900px) {
    .case,
    .case--alt {
      grid-template-columns: 1fr;
    }
    .case--alt .report {
      order: 0;
    }
    .report {
      padding: 18px;
    }
  }
  @media (max-width: 420px) {
    .report__grid {
      grid-template-columns: 1fr;
    }
  }
  .proof__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .proof__sym {
    position: absolute;
    left: -12vw;
    top: 50%;
    width: 54vw;
    max-width: 820px;
    translate: 0 -50%;
    opacity: 0.08;
  }
  .proof__head {
    display: grid;
    gap: 24px;
    max-width: 900px;
    margin-left: auto;
  }
  .proof__stats {
    position: relative;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
  }
  .proof__stats li {
    padding: 32px 24px 0;
  }
  .proof__stats li + li {
    border-left: 1px solid var(--line);
  }
  .proof__stats li:first-child {
    padding-left: 0;
  }
  .proof__num {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(3rem, 6.6vw, 6.4rem);
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .proof__pre,
  .proof__suf {
    background: var(--sun);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .proof__pre {
    font-size: 0.55em;
    vertical-align: 0.6em;
    margin-right: 0.04em;
  }
  .proof__label {
    margin-top: 14px;
    color: var(--mute);
  }
  @media (max-width: 900px) {
    .proof__stats {
      grid-template-columns: 1fr 1fr;
    }
    .proof__stats li:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .proof__stats li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
      margin-top: 32px;
    }
    .proof__stats li {
      padding: 26px 16px 0;
    }
    .proof__stats li:nth-child(odd) {
      padding-left: 0;
    }
  }
</style>
