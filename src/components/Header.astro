---
import Symbol from './Symbol.astro';
import Button from './Button.astro';
const links = [
  { href: '#servicos', label: 'Serviços' },
  { href: '#diferenca', label: 'Diferença' },
  { href: '#resultados', label: 'Resultados' },
  { href: '#metodo', label: 'Método' },
  { href: '#faq', label: 'FAQ' },
];
---
<header class="hdr" data-header>
  <div class="hdr__in wrap">
    <a class="hdr__logo" href="#topo" aria-label="BACKE.co, voltar ao início">
      <Symbol class="hdr__sym" />
    </a>
    <nav class="hdr__nav" aria-label="Principal">
      <ul>
        {links.map((l) => <li><a href={l.href} data-track="nav">{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="hdr__cta">
      <Button href="#diagnostico" size="sm" data-cta="header">Diagnóstico gratuito</Button>
      <button class="hdr__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only">Abrir menu</span>
        <i></i><i></i>
      </button>
    </div>
  </div>
  <div class="menu" id="menu" hidden data-menu>
    <ul>
      {links.map((l, i) => <li style={`--i:${i}`}><a href={l.href} data-menu-link>{l.label}</a></li>)}
      <li style={`--i:${links.length}`}><a href="#diagnostico" data-menu-link class="menu__cta">Pedir diagnóstico</a></li>
    </ul>
    <Symbol class="menu__sym" />
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    transition: transform 0.5s var(--ease-out), background 0.4s, box-shadow 0.4s;
  }
  .hdr.is-scrolled {
    background: rgb(0 0 0 / 0.72);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 1px 0 var(--line);
  }
  .hdr.is-hidden {
    transform: translateY(-100%);
  }
  .hdr__in {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .hdr__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .hdr__sym {
    width: 40px;
    height: 40px;
    transition: transform 0.6s var(--ease-out);
  }
  .hdr__logo:hover .hdr__sym {
    transform: rotate(-8deg) scale(1.05);
  }
  .hdr__name {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.04em;
  }
  .hdr__name span {
    color: var(--mute);
    font-weight: 400;
  }
  .hdr__nav ul {
    display: flex;
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .hdr__nav a {
    display: block;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--mute);
    transition: color 0.2s, background 0.2s;
  }
  .hdr__nav a:hover,
  .hdr__nav a.is-active {
    color: var(--text);
    background: rgb(255 255 255 / 0.07);
  }
  .hdr__cta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hdr__menu {
    display: none;
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .hdr__menu i {
    position: absolute;
    left: 15px;
    right: 15px;
    height: 1.5px;
    background: var(--text);
    transition: transform 0.4s var(--ease-out);
  }
  .hdr__menu i:first-of-type {
    top: 20px;
  }
  .hdr__menu i:last-of-type {
    top: 27px;
  }
  .hdr__menu[aria-expanded='true'] i:first-of-type {
    transform: translateY(3.5px) rotate(45deg);
  }
  .hdr__menu[aria-expanded='true'] i:last-of-type {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: var(--black);
    padding: 32px var(--gutter);
    overflow: hidden;
  }
  .menu ul {
    display: grid;
    gap: 6px;
  }
  .menu a {
    display: block;
    font-family: var(--f-display);
    font-size: clamp(2.2rem, 10vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
    line-height: 1.15;
    animation: menu-in 0.6s var(--ease-out) both;
    animation-delay: calc(var(--i) * 50ms);
  }
  .menu__cta {
    color: var(--orange);
  }
  .menu__sym {
    position: absolute;
    right: -30%;
    bottom: -20%;
    width: 110%;
    opacity: 0.18;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  @media (max-width: 1024px) {
    .hdr__nav {
      display: none;
    }
    .hdr__menu {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .hdr__cta :global(.btn) {
      display: none;
    }
  }
</style>
