---
import { CONTACT } from '../data/content';
import { whatsappLink } from '../lib/lead';
---
<div class="mcta" data-mobile-cta aria-hidden="true">
  <a class="mcta__main" href="#diagnostico" data-cta="mobile-bar" tabindex="-1">
    Diagnóstico gratuito
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
  </a>
  <a class="mcta__wa" href={whatsappLink(CONTACT.whatsappText)} target="_blank" rel="noopener" data-cta="mobile-bar-whatsapp" tabindex="-1" aria-label="Falar no WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91A9.84 9.84 0 0 0 12.04 2Zm5.8 14.03c-.24.68-1.42 1.3-1.96 1.35-.5.05-.98.24-3.3-.69-2.8-1.1-4.56-3.98-4.7-4.17-.13-.18-1.12-1.49-1.12-2.84s.71-2.01.96-2.29c.25-.27.55-.34.73-.34l.52.01c.17 0 .39-.06.61.47.24.55.8 1.92.87 2.06.07.14.12.3.02.48-.09.18-.14.3-.27.46l-.41.48c-.14.14-.28.29-.12.56.16.27.71 1.17 1.53 1.9 1.05.94 1.93 1.23 2.2 1.37.27.14.43.11.59-.07.16-.18.68-.79.86-1.07.18-.27.36-.23.61-.14.25.09 1.58.75 1.85.88.27.14.45.2.52.32.07.11.07.66-.17 1.34Z"></path></svg>
  </a>
</div>

<style>
  .mcta {
    display: none;
  }
  @media (max-width: 860px) {
    .mcta {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      z-index: 40;
      display: flex;
      gap: 8px;
      transform: translateY(140%);
      transition: transform 0.6s var(--ease-out);
    }
    .mcta.is-visible {
      transform: none;
    }
  }
  .mcta__main {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--orange);
    color: var(--black);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 12px 40px -8px rgb(0 0 0 / 0.7), 0 8px 30px -10px rgb(255 106 0 / 0.6);
  }
  .mcta__main:active {
    transform: scale(0.97);
  }
  .mcta__main svg {
    position: relative;
    z-index: 1;
    width: 20px;
    transform: rotate(calc(var(--cut) * -1));
  }
  .mcta__wa {
    position: relative;
    overflow: hidden;
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #111;
    color: #25d366;
    box-shadow: inset 0 0 0 1px var(--line-strong), 0 12px 40px -8px rgb(0 0 0 / 0.7);
  }
  .mcta__wa svg {
    width: 26px;
  }
</style>
