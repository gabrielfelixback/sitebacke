---
import Symbol from './Symbol.astro';
---
<section class="duo" aria-labelledby="duo-title" data-duo>
  <div class="duo__stick">
    <div class="sunrise duo__glow" aria-hidden="true" data-duo-glow></div>

    <div class="duo__stage wrap">
      <p class="duo__side duo__side--l" data-duo-l>
        <span class="duo__tag">Estratégia</span>
        Sem criatividade, estratégia <em class="serif">não é lembrada.</em>
      </p>

      <div class="duo__mark" aria-hidden="true">
        <Symbol part="stem" class="duo__part" data-duo-stem />
        <Symbol part="bowl" class="duo__part" data-duo-bowl />
      </div>

      <p class="duo__side duo__side--r" data-duo-r>
        <span class="duo__tag">Criatividade</span>
        Sem estratégia, criatividade <em class="serif">não escala.</em>
      </p>
    </div>

    <div class="duo__end wrap" data-duo-end>
      <h2 class="h2" id="duo-title">A Backe nasceu para <span class="serif lit">não escolher.</span></h2>
      <p class="lede">
        Cada decisão começa com dados e termina numa execução criativa que faz sua marca ser lembrada — e escolhida.
        Não terceirizamos o pensamento: a estratégia do seu negócio é tratada como se fosse a nossa.
      </p>
    </div>
  </div>
</section>

<style>
  .duo {
    position: relative;
    height: 260vh;
    background: var(--black);
  }
  .duo__stick {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .duo__glow {
    width: 90vmin;
    height: 90vmin;
    left: 50%;
    top: 46%;
    translate: -50% -50%;
    opacity: 0.2;
  }
  .duo__stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(180px, 30vmin) 1fr;
    grid-template-areas:
      'l . .'
      '. m .'
      '. . r';
    align-items: center;
    row-gap: 2vh;
    column-gap: clamp(16px, 4vw, 64px);
    margin-top: -6vh;
    will-change: transform;
  }
  .duo__mark {
    grid-area: m;
    position: relative;
    aspect-ratio: 504 / 506;
  }
  .duo__part {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    will-change: transform;
  }
  .duo__side {
    font-family: var(--f-display);
    font-size: clamp(1.25rem, 2.4vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 500;
    max-width: 15ch;
  }
  .duo__side--l {
    grid-area: l;
    justify-self: end;
    text-align: right;
  }
  .duo__side--r {
    grid-area: r;
  }
  .duo__side em {
    color: var(--mute);
  }
  .duo__tag {
    display: block;
    margin-bottom: 14px;
    font-family: var(--f-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange);
  }
  .duo__end {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(2.5rem, 8vh, 6rem);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    align-items: end;
  }
  .duo__end .lede {
    color: #c9c5c0;
  }
  @media (max-width: 900px) {
    .duo {
      height: 220vh;
    }
    .duo__stage {
      grid-template-columns: 1fr;
      grid-template-areas: 'l' 'm' 'r';
      justify-items: center;
      text-align: center;
      gap: 24px;
      margin-top: -18vh;
    }
    .duo__side,
    .duo__side--l {
      justify-self: center;
      text-align: center;
      font-size: 1.15rem;
    }
    .duo__mark {
      width: 42vw;
    }
    .duo__end {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .duo__end .lede {
      font-size: 0.98rem;
    }
  }
  /* sem JS / movimento reduzido: tudo visível, símbolo montado */
  @media (prefers-reduced-motion: reduce) {
    .duo {
      height: auto;
    }
    .duo__stick {
      position: relative;
      height: auto;
      padding-block: 8rem;
      gap: 4rem;
    }
    .duo__stage {
      margin-top: 0;
    }
    .duo__end {
      position: relative;
      bottom: auto;
    }
  }
</style>
