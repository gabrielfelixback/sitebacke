---
/** Faixa de palavras gigantes que anda com a rolagem. Preenche a transição entre seções. */
import Symbol from './Symbol.astro';
interface Props {
  words: string[];
  reverse?: boolean;
}
const { words, reverse = false } = Astro.props;
const row = [...words, ...words, ...words];
---
<div class="band" aria-hidden="true" data-band data-dir={reverse ? '-1' : '1'}>
  <div class="band__track" data-band-track>
    {
      row.map((w, i) => (
        <>
          <span class={`band__w ${i % words.length === 1 ? 'band__w--lit' : ''}`}>{w}</span>
          <Symbol class="band__sym" />
        </>
      ))
    }
  </div>
</div>

<style>
  .band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.5rem, 4vw, 3rem);
    background: #000;
    border-block: 1px solid var(--line);
  }
  .band__track {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 48px);
    width: max-content;
    will-change: transform;
  }
  .band__w {
    font-family: var(--f-display);
    font-size: clamp(3.2rem, 10vw, 9.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.22);
    white-space: nowrap;
  }
  .band__w--lit {
    -webkit-text-stroke: 0;
    background: linear-gradient(180deg, var(--sun-1), var(--sun-2) 55%, var(--sun-3));
    -webkit-background-clip: text;
    background-clip: text;
  }
  .band__sym {
    flex: none;
    width: clamp(36px, 6vw, 84px);
    height: auto;
  }
</style>
