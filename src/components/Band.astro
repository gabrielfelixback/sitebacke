---
/** Faixa de palavras gigantes que anda com a rolagem. Preenche a transição entre seções. */
interface Props {
  words: string[];
  reverse?: boolean;
}
const { words, reverse = false } = Astro.props;
const row = [...words, ...words, ...words];
---
<div class="band" aria-hidden="true" data-band data-dir={reverse ? '-1' : '1'}>
  <div class="band__track" data-band-track>
    {
      row.map((w, i) => (
        <span class="band__w">{w}</span>
      ))
    }
  </div>
</div>

<style>
  .band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.5rem, 4vw, 3rem);
    background: #000;
    border-block: 1px solid var(--line);
  }
  .band__track {
    display: flex;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    width: max-content;
    will-change: transform;
  }
  .band__w {
    font-family: var(--f-display);
    font-size: clamp(4.4rem, 12vw, 9.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.05em;
    white-space: nowrap;
    padding-right: 0.08em;
    background: linear-gradient(180deg, var(--sun-1), var(--sun-2) 55%, var(--sun-3));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
