---
import Button from './Button.astro';
import { asset } from '../lib/url';
const mask = `--mask:url(${asset('backe-symbol.svg')})`;
---
<!--
  Hero: o símbolo da Backe como janela. O vídeo próprio da Backe passa dentro do “b”
  e a frase fica contida no miolo da letra. Ao rolar, a câmera mergulha no disco do “b”
  até o vídeo tomar a tela.
-->
<section class="hero" id="topo" aria-labelledby="hero-title" data-hero style={mask}>
  <div class="hero__stick">
    <div class="hero__halo" aria-hidden="true"></div>
    <div class="hero__media" data-hero-media>
      <video class="hero__video" data-hero-video muted loop playsinline autoplay preload="auto" poster={asset('video/reel-poster.jpg')} aria-hidden="true">
        <source src={asset('video/reel-vertical.mp4')} type="video/mp4" media="(max-width: 900px)" />
        <source src={asset('video/reel-1080.mp4')} type="video/mp4" />
      </video>
      <div class="hero__tint"></div>
    </div>

    <div class="hero__copy" data-hero-copy>
      <!-- TÍTULO PROVISÓRIO: aguardando definição da Backe -->
      <h1 class="hero__title" id="hero-title">
        <span class="line"><span data-hero-line style="--i:0">Estratégia</span></span>
        <span class="line"><span data-hero-line style="--i:1">com criatividade.</span></span>
      </h1>
      <div class="hero__more">
        <p class="hero__lede" data-hero-in style="--i:1">
          Agência de marketing estratégico e criativo. Posicionamento, mídia, marca e imagem num único plano.
        </p>
        <div class="hero__actions" data-hero-in style="--i:2">
          <Button href="#diagnostico" data-cta="hero" data-magnetic>Quero meu diagnóstico gratuito</Button>
        </div>
      </div>
    </div>

    <p class="hero__after" data-hero-after aria-hidden="true">
      Criatividade sem estratégia não escala. Estratégia sem criatividade não é lembrada.
    </p>

    <a class="hero__scroll" href="#custo" data-hero-in style="--i:4"><span aria-hidden="true"></span>Role para ver</a>
  </div>
</section>

<style>
  .hero {
    /* tamanho do símbolo e onde fica o miolo do “b” (frações do quadro 504x506 do vetor) */
    --S0: max(104vw, calc(var(--vh, 1svh) * 168));
    --ax: 0.476;
    --ay: 0.613;
    --cx: 50vw;
    --cy: calc(var(--vh, 1svh) * 50);
    position: relative;
    height: calc(var(--vh, 1svh) * 230);
    background: #000;
  }
  .hero__stick {
    position: sticky;
    top: 0;
    height: calc(var(--vh, 1svh) * 100);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__media,
  .hero__halo {
    position: absolute;
    inset: 0;
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: var(--S, var(--S0)) auto;
    mask-size: var(--S, var(--S0)) auto;
    -webkit-mask-position: calc(var(--cx) - var(--axz, var(--ax)) * var(--S, var(--S0))) calc(var(--cy) - var(--ayz, var(--ay)) * var(--S, var(--S0)) * 1.004);
    mask-position: calc(var(--cx) - var(--axz, var(--ax)) * var(--S, var(--S0))) calc(var(--cy) - var(--ayz, var(--ay)) * var(--S, var(--S0)) * 1.004);
  }
  .hero.is-open .hero__media {
    -webkit-mask-image: none;
    mask-image: none;
  }
  /* halo: o próprio símbolo no degradê da marca, desfocado atrás do vídeo */
  .hero__halo {
    background: linear-gradient(180deg, var(--sun-1), var(--sun-2) 50%, var(--sun-3));
    filter: blur(28px);
    opacity: 0.55;
    transform: scale(1.01);
  }
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__tint {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.15), rgb(0 0 0 / 0.35)),
      linear-gradient(0deg, rgb(254 67 77 / 0.18), transparent 50%);
    opacity: var(--tint, 1);
  }

  /* a frase dentro do miolo do “b” */
  .hero__copy {
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    translate: -50% -50%;
    width: calc(var(--S0) * 0.43);
    max-width: calc(100vw - 2 * var(--gutter));
    text-align: center;
    z-index: 2;
    will-change: opacity, transform;
  }
  .hero__title {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: min(calc(var(--S0) * 0.05), 8.5vw);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variation-settings: 'opsz' 96;
  }
  .hero__title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero__title .line > span {
    display: inline-block;
    background: linear-gradient(180deg, #fff 0%, #fff 50%, #ffdcc4 85%, #ffa36b 110%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.04em;
  }
  .hero__more {
    display: grid;
    justify-items: center;
    gap: 22px;
    margin-top: 18px;
  }
  .hero__lede {
    max-width: 34ch;
    color: #c9c4be;
    font-size: clamp(0.98rem, 1.15vw, 1.1rem);
    line-height: 1.55;
    text-wrap: balance;
  }
  .hero__after {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(3rem, calc(var(--vh, 1svh) * 12), 7rem);
    max-width: 18ch;
    font-family: var(--f-display);
    font-size: clamp(2.2rem, 5.4vw, 5.4rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-wrap: balance;
    opacity: 0;
    z-index: 2;
    text-shadow: 0 10px 50px rgb(0 0 0 / 0.5);
  }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 24px;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 0.85rem;
    color: var(--mute);
    text-decoration: none;
    z-index: 2;
  }
  .hero__scroll span {
    position: relative;
    width: 22px;
    height: 34px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
  }
  .hero__scroll span::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 7px;
    width: 3px;
    height: 7px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--orange);
    animation: scrolldot 2s var(--ease-in-out) infinite;
  }
  @keyframes scrolldot {
    60% {
      transform: translateY(12px);
      opacity: 0;
    }
    61% {
      transform: none;
      opacity: 0;
    }
  }

  /* entrada: o “b” acende e a frase sobe */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero__media {
      animation: hero-open 1.8s var(--ease-out) both;
    }
    :global(.js) .hero__halo {
      animation: hero-halo 2.4s var(--ease-out) both;
    }
    :global(.js) [data-hero-line] {
      animation: hero-line 1.2s var(--ease-out) both;
      animation-delay: calc(0.35s + var(--i) * 0.12s);
    }
    :global(.js) [data-hero-in] {
      animation: hero-in 1s var(--ease-out) both;
      animation-delay: calc(0.6s + var(--i) * 0.09s);
    }
  }
  @keyframes hero-open {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }
  @keyframes hero-halo {
    from {
      opacity: 0;
    }
  }
  @keyframes hero-line {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @media (max-width: 900px) {
    /* celular: o “b” inteiro com o vídeo, a frase no miolo e o texto logo abaixo da letra */
    .hero {
      --S0: 124vw;
      --cx: calc(124vw * 0.476 + 10px);
      --cy: calc(var(--vh, 1svh) * 38);
      height: calc(var(--vh, 1svh) * 200);
    }
    .hero__copy {
      width: calc(var(--S0) * 0.39);
      text-shadow: 0 2px 24px rgb(0 0 0 / 0.6);
    }
    .hero__title {
      font-size: min(7.4vw, 2.2rem);
    }
    .hero__more {
      position: absolute;
      left: calc(50vw - var(--cx) + 50%);
      top: calc(50% + var(--S0) * 0.39 + 22px);
      translate: -50% 0;
      width: calc(100vw - 2 * var(--gutter));
      margin: 0;
      gap: 18px;
    }
    .hero__lede {
      font-size: 0.98rem;
    }
    .hero__actions :global(.btn) {
      width: calc(100vw - 2 * var(--gutter));
      justify-content: space-between;
    }
    .hero__scroll {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
    .hero__stick {
      position: relative;
    }
  }
</style>
