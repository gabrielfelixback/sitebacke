---
import { asset } from '../lib/url';
// No desktop o hero usa o vídeo horizontal, então aqui entra o vertical (formato de redes).
// No celular é o contrário: o hero usa o vertical e aqui entra o horizontal.
---
<section class="show" id="audiovisual" aria-labelledby="show-title">
  <div class="wrap show__grid">
    <div class="show__copy">
      <h2 class="show__title" id="show-title">A Backe nasceu para não escolher entre as duas.</h2>
      <p class="show__p">
        Cada decisão começa com dados e termina numa execução criativa. E boa parte do que você vê nas nossas campanhas
        é captado pelo nosso próprio time: drone, direção, gravação e edição.
      </p>
      <ul class="show__list">
        <li>Captação aérea com drone</li>
        <li>Vídeos para campanhas e redes</li>
        <li>Direção, gravação e edição</li>
      </ul>
      <a class="link-arrow" href="#diagnostico" data-interest="Captação Audiovisual / Drone" data-cta="audiovisual">
        Quero imagens assim para a minha marca
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
      </a>
    </div>

    <div class="show__frame">
      <video class="show__video" data-autoplay muted loop playsinline preload="none" poster={asset('video/reel-vertical-poster.jpg')} aria-label="Vídeo de captação aérea feito pela Backe">
        <source src={asset('video/reel-720.mp4')} type="video/mp4" media="(max-width: 900px)" />
        <source src={asset('video/reel-vertical.mp4')} type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<style>
  .show {
    position: relative;
    background:
      radial-gradient(60% 70% at 80% 50%, rgb(254 67 77 / 0.16), transparent 70%),
      var(--ink);
    padding-block: clamp(5rem, 10vw, 8rem);
    overflow: hidden;
  }
  .show__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .show__copy {
    display: grid;
    gap: 26px;
    justify-items: start;
  }
  .show__title {
    font-family: var(--f-display);
    font-size: clamp(2.4rem, 5vw, 5rem);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.045em;
    font-variation-settings: 'opsz' 96;
    text-wrap: balance;
  }
  .show__p {
    color: var(--mute);
    font-size: 1.1rem;
    max-width: 42ch;
  }
  .show__list {
    display: grid;
    gap: 10px;
  }
  .show__list li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .show__list li::before {
    content: '';
    width: 12px;
    height: 6px;
    border-radius: 12px 12px 0 0;
    background: var(--sun);
  }
  .show__frame {
    justify-self: center;
    width: min(100%, 400px);
    aspect-ratio: 9 / 16;
    padding: 10px;
    border-radius: 40px;
    background: linear-gradient(160deg, #2a2624, #0e0d0c);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 40px 120px -30px rgb(254 67 77 / 0.5);
  }
  .show__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 31px;
    background: #000;
  }
  @media (max-width: 900px) {
    .show__grid {
      grid-template-columns: 1fr;
    }
    .show__frame {
      order: -1;
      width: 100%;
      aspect-ratio: 16 / 9;
      padding: 6px;
      border-radius: 24px;
    }
    .show__video {
      border-radius: 19px;
    }
  }
</style>
