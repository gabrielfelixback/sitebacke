---
import { asset } from '../lib/url';
---
<section class="reel" id="reel" aria-labelledby="reel-title" data-reel>
  <div class="reel__stick">
    <div class="reel__media" data-reel-media>
      <video
        class="reel__video"
        data-reel-video
        muted
        loop
        playsinline
        preload="none"
        poster={asset('video/reel-poster.jpg')}
        aria-label="Showreel Backe: captação aérea e audiovisual própria"
      >
        <source src={asset('video/reel-480.mp4')} type="video/mp4" media="(max-width: 900px)" />
        <source src={asset('video/reel-720.mp4')} type="video/mp4" />
      </video>
      <div class="reel__shade" data-reel-shade></div>
    </div>

    <p class="reel__side reel__side--l" data-reel-l>Criatividade sem estratégia não escala.</p>
    <p class="reel__side reel__side--r" data-reel-r>Estratégia sem criatividade não é lembrada.</p>

    <div class="reel__end wrap" data-reel-end>
      <h2 class="reel__title" id="reel-title">A Backe nasceu para não escolher entre as duas.</h2>
      <p class="reel__p">
        Cada decisão começa com dados e termina numa execução criativa. A captação aérea e o audiovisual são feitos pelo
        nosso próprio time.
      </p>
      <button class="reel__sound" type="button" data-reel-toggle aria-pressed="false">
        <span class="reel__sound-i" aria-hidden="true"></span><span data-reel-toggle-label>Pausar vídeo</span>
      </button>
    </div>
  </div>
</section>

<style>
  .reel {
    position: relative;
    height: 320vh;
    background: #000;
  }
  .reel__stick {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .reel__media {
    position: absolute;
    inset: 0;
    --ms: 34vmin;
    --mx: calc(50% - 17vmin);
    --my: calc(50% - 17vmin);
  }
  :global(.js) .reel__media.is-masked {
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: var(--ms) auto;
    mask-size: var(--ms) auto;
    -webkit-mask-position: var(--mx) var(--my);
    mask-position: var(--mx) var(--my);
  }
  .reel__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reel__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.1) 30%, rgb(0 0 0 / 0.85) 100%),
      radial-gradient(80% 60% at 50% 110%, rgb(254 67 77 / 0.35), transparent 70%);
    opacity: var(--shade, 1);
  }
  .reel__side {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    max-width: 15ch;
    font-family: var(--f-display);
    font-size: clamp(1.4rem, 2.6vw, 2.4rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    z-index: 2;
  }
  .reel__side--l {
    left: var(--gutter);
  }
  .reel__side--r {
    right: var(--gutter);
    text-align: right;
    color: var(--mute);
  }
  .reel__end {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(2.5rem, 8vh, 5.5rem);
    z-index: 2;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 16px 48px;
    align-items: end;
  }
  .reel__title {
    font-family: var(--f-display);
    font-size: clamp(2.4rem, 5.6vw, 5.6rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-variation-settings: 'opsz' 96;
    text-wrap: balance;
  }
  .reel__p {
    color: #d8d3cd;
    font-size: 1.05rem;
    max-width: 34ch;
  }
  .reel__sound {
    grid-column: 2;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.88rem;
  }
  .reel__sound-i {
    width: 10px;
    height: 12px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .reel__sound[aria-pressed='true'] .reel__sound-i {
    width: 0;
    height: 0;
    border-left: 10px solid currentColor;
    border-right: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }
  @media (max-width: 900px) {
    .reel {
      height: 260vh;
    }
    .reel__side {
      top: auto;
      translate: none;
      font-size: 1.15rem;
      max-width: 16ch;
    }
    .reel__side--l {
      top: calc(var(--header-h) + 24px);
    }
    .reel__side--r {
      bottom: 14vh;
    }
    .reel__end {
      grid-template-columns: 1fr;
    }
    .reel__sound {
      grid-column: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reel {
      height: auto;
    }
    .reel__stick {
      position: relative;
      height: 100svh;
    }
    .reel__side {
      display: none;
    }
  }
</style>
