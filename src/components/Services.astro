---
import { FRONTS } from '../data/content';
import { asset } from '../lib/url';
import Vbox from './Vbox.astro';
// cada frente aceita foto (img) ou vídeo em loop (base dos arquivos de scripts/encode-videos.sh)
const media: Record<string, { img?: string; video?: string; pos?: string }> = {
  estrategia: { img: 'fotos/estrategia-backe-v2.webp', pos: '50% 50%' },
  demanda: { video: 'frente-demanda' },
  marca: { img: 'fotos/marca-backe.webp', pos: '78% 50%' },
  imagem: { video: 'drone-loop' },
};
const firstSentence = (t: string) => t.split(/(?<=\.)\s/)[0];
---
<section class="svc" id="servicos" aria-labelledby="svc-title">
  <div class="wrap">
    <header class="svc__head">
      <p class="eyebrow">Serviços</p>
      <h2 class="svc__title" id="svc-title">Um time, quatro frentes e um <em class="hl">plano</em> só.</h2>
      <p class="svc__lede">
        Você não precisa de mais um fornecedor de posts ou anúncios. Precisa de uma equipe que estruture o marketing
        inteiro e faça cada frente trabalhar a favor da outra.
      </p>
    </header>

    <div class="stack" data-stack aria-label="As quatro frentes da Backe">
      {
        FRONTS.map((f, i) => (
          <article class={`fcard fcard--${f.id}`} style={`--i:${i}`} data-fcard aria-labelledby={`fc-${f.id}`}>
            <div class="fcard__body">
              <p class="fcard__count">
                Frente {i + 1} de {FRONTS.length}
              </p>
              <h3 class="fcard__name" id={`fc-${f.id}`}>
                {f.name}
              </h3>
              <p class="fcard__promise">{f.promise}</p>
              <ul class="fcard__list" id={`fl-${f.id}`}>
                {f.services.map((s) => (
                  <li>
                    <a class="srv" href="#diagnostico" data-interest={s.title} data-cta="servico">
                      <span class="srv__t">{s.title}</span>
                      <span class="srv__d">{firstSentence(s.impact)}</span>
                      <span class="srv__tags">{s.deliverables.map((d) => <span>{d}</span>)}</span>
                      <span class="srv__go" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <button class="fcard__more" type="button" aria-expanded="false" aria-controls={`fl-${f.id}`} data-more>
                <span data-more-label>Ver detalhes</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
            </div>
            <div class="fcard__media" aria-hidden="true">
              <div class="fcard__frame">
                {media[f.id].video ? (
                  <Vbox base={media[f.id].video!} class="fcard__vbox" />
                ) : (
                  <img src={asset(media[f.id].img!)} alt="" loading="lazy" decoding="async" class="fcard__photo" style={media[f.id].pos ? `object-position:${media[f.id].pos}` : undefined} />
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="svc__nav" data-stack-nav>
      <div class="svc__dots">
        {FRONTS.map((f, i) => (
          <button type="button" class="svc__dot" aria-label={`Ir para a frente ${f.name}`} aria-current={i === 0 ? 'true' : undefined} data-dot={i}></button>
        ))}
      </div>
      <p class="svc__hint" data-stack-hint>Deslize para ver as 4 frentes</p>
    </div>
  </div>
</section>

<script>
  // celular: carrossel das frentes (pontinhos, dica que some) e “Ver detalhes”
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  const nav = document.querySelector<HTMLElement>('[data-stack-nav]');
  if (stack && nav) {
    const cards = Array.from(stack.querySelectorAll<HTMLElement>('[data-fcard]'));
    const dots = Array.from(nav.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const hint = nav.querySelector<HTMLElement>('[data-stack-hint]');
    const current = () => {
      const mid = stack.scrollLeft + stack.clientWidth / 2;
      let best = 0;
      cards.forEach((c, i) => {
        if (Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid) < Math.abs(cards[best].offsetLeft + cards[best].offsetWidth / 2 - mid)) best = i;
      });
      return best;
    };
    let raf = 0;
    stack.addEventListener(
      'scroll',
      () => {
        if (stack.scrollLeft > 12) hint?.classList.add('is-gone');
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const c = current();
          dots.forEach((d, i) => (i === c ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
        });
      },
      { passive: true },
    );
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        const c = cards[i];
        stack.scrollTo({ left: c.offsetLeft - (stack.clientWidth - c.offsetWidth) / 2, behavior: 'smooth' });
      }),
    );
  }
  document.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((b) =>
    b.addEventListener('click', () => {
      const card = b.closest('[data-fcard]')!;
      const open = b.getAttribute('aria-expanded') !== 'true';
      card.classList.toggle('is-open', open);
      b.setAttribute('aria-expanded', String(open));
      b.querySelector('[data-more-label]')!.textContent = open ? 'Ocultar detalhes' : 'Ver detalhes';
    }),
  );
</script>

<style>
  .svc {
    position: relative;
    background: #000;
    padding-block: clamp(6rem, 12vw, 10rem) clamp(4rem, 8vw, 6rem);
  }
  .svc__head {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 32px 64px;
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .svc__title {
    font-family: var(--f-display);
    font-size: clamp(2.6rem, 6vw, 6rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-variation-settings: 'opsz' 96;
    max-width: 12ch;
  }
  .svc__lede {
    color: var(--mute);
    font-size: 1.1rem;
    max-width: 36ch;
  }

  .stack {
    display: grid;
    gap: 24px;
  }
  .fcard {
    position: sticky;
    top: calc(var(--header-h) + 20px + var(--i) * 18px);
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    min-height: min(calc(var(--vh, 1svh) * 78), 720px);
    border-radius: 36px;
    overflow: hidden;
    background:
      radial-gradient(70% 90% at 100% 100%, rgb(254 67 77 / 0.22), transparent 60%),
      radial-gradient(60% 70% at 85% 20%, rgb(241 143 52 / 0.12), transparent 60%),
      linear-gradient(160deg, #1b1918 0%, #0e0d0c 70%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      0 -30px 80px -30px rgb(0 0 0 / 0.9);
    transform-origin: 50% 0;
    will-change: transform;
    transition: box-shadow 1.2s var(--ease-out);
  }
  /* aceso pelo sol (public/sol.js) quando o topo do card passa de 62% da tela */
  .fcard.is-lit {
    box-shadow:
      inset 0 1px rgb(241 143 52 / 0.55),
      inset 0 0 0 1px rgb(241 143 52 / 0.16),
      0 -30px 80px -30px rgb(0 0 0 / 0.9);
  }
  .fcard__body {
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 4vw, 56px);
  }
  .fcard__count {
    font-size: 0.9rem;
    color: var(--mute);
  }
  .fcard__name {
    margin-top: 18px;
    font-family: var(--f-display);
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.05em;
    font-variation-settings: 'opsz' 96;
    background: linear-gradient(180deg, #fff 40%, #ffc7a3 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .fcard__promise {
    margin-top: 16px;
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    color: #d6d1cb;
  }
  .fcard__list {
    margin-top: auto;
    padding-top: 36px;
    display: grid;
  }
  .srv {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 40px;
    grid-template-areas: 't go' 'd go' 'g g';
    gap: 4px 16px;
    align-items: center;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .srv__t {
    grid-area: t;
    font-weight: 600;
    font-size: 1.05rem;
    transition: color 0.3s;
  }
  .srv__d {
    grid-area: d;
    font-size: 0.92rem;
    color: var(--mute);
  }
  .srv__go {
    grid-area: go;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: background 0.35s, box-shadow 0.35s, transform 0.5s var(--ease-out);
  }
  .srv__go svg {
    width: 16px;
    transform: rotate(calc(var(--cut) * -1));
  }
  .srv:hover .srv__t {
    color: var(--orange);
  }
  .srv:hover .srv__go {
    background: var(--orange);
    color: var(--black);
    box-shadow: none;
    transform: translateX(4px);
  }
  .fcard__media {
    position: relative;
    padding: 14px;
    min-height: 0;
  }
  .fcard__frame {
    position: relative;
    height: 100%;
    min-height: 260px;
    border-radius: 26px;
    overflow: hidden;
  }
  .fcard__frame :global(.fcard__vbox) {
    position: absolute;
    inset: 0;
  }
  .fcard__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
    transition: transform 1.4s var(--ease-out);
  }
  .fcard__frame::after {
    /* a luz da marca por cima da foto, para ela conversar com o resto do site */
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(180deg, transparent 45%, rgb(14 13 12 / 0.55)),
      radial-gradient(80% 60% at 100% 100%, rgb(254 67 77 / 0.28), transparent 70%);
  }
  .srv__tags {
    grid-area: g;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .srv__tags span {
    font-size: 0.78rem;
    padding: 4px 10px;
    border-radius: 999px;
    color: #d6d1cb;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .fcard:hover .fcard__photo {
    transform: scale(1.03);
  }
  .fcard__more,
  .svc__nav {
    display: none;
  }
  .svc__head .eyebrow {
    grid-column: 1 / -1;
  }

  @media (max-width: 900px) {
    .svc {
      padding-block: 4.5rem 3.5rem;
    }
    .svc__head {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 2rem;
    }
    /* carrossel horizontal: o próximo card aparece na borda */
    .stack {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-bottom: 4px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .stack::-webkit-scrollbar {
      display: none;
    }
    .fcard {
      position: relative;
      top: auto;
      flex: 0 0 86%;
      scroll-snap-align: center;
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      align-content: start;
      min-height: 0;
      border-radius: 26px;
      will-change: auto;
    }
    .fcard__media {
      order: -1;
      padding: 10px 10px 0;
    }
    .fcard__frame {
      height: auto;
      min-height: 0;
      aspect-ratio: 16 / 10;
      border-radius: 18px;
    }
    .fcard__body {
      padding: 16px 18px 18px;
    }
    .fcard__count {
      font-size: 0.8rem;
    }
    .fcard__name {
      margin-top: 6px;
      font-size: 2.3rem;
    }
    .fcard__promise {
      margin-top: 6px;
      font-size: 1rem;
    }
    /* nomes dos serviços como chips; descrição e tags atrás de “Ver detalhes” */
    .fcard__list {
      margin-top: 14px;
      padding-top: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .srv {
      display: inline-flex;
      align-items: center;
      min-height: 36px;
      padding: 6px 12px;
      border: 0;
      border-radius: 999px;
      background: rgb(255 255 255 / 0.06);
      box-shadow: inset 0 0 0 1px var(--line-strong);
    }
    .srv__t {
      font-size: 0.85rem;
      font-weight: 600;
    }
    .srv__d,
    .srv__tags,
    .srv__go {
      display: none;
    }
    .fcard.is-open .fcard__list {
      display: grid;
      gap: 0;
    }
    .fcard.is-open .srv {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas: 't' 'd' 'g';
      gap: 4px;
      padding: 12px 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      border-top: 1px solid var(--line);
    }
    .fcard.is-open .srv__d {
      display: block;
      font-size: 0.88rem;
    }
    .fcard.is-open .srv__tags {
      display: flex;
    }
    .fcard__more {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 44px;
      margin-top: 8px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--sun-2);
      font-weight: 600;
      font-size: 0.9rem;
    }
    .fcard__more svg {
      width: 18px;
      height: 18px;
      transition: transform 0.3s;
    }
    .fcard__more[aria-expanded='true'] svg {
      transform: rotate(180deg);
    }
    .svc__nav {
      display: grid;
      justify-items: center;
      gap: 8px;
      margin-top: 16px;
    }
    .svc__dots {
      display: flex;
      gap: 4px;
    }
    .svc__dot {
      position: relative;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      background: none;
    }
    .svc__dot::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 50%;
      width: 8px;
      height: 8px;
      margin: -4px 0 0 -4px;
      border-radius: 999px;
      background: rgb(255 255 255 / 0.22);
      transition: width 0.3s, margin 0.3s, background 0.3s;
    }
    .svc__dot[aria-current='true']::after {
      width: 22px;
      margin-left: -11px;
      background: var(--sun-2);
    }
    .svc__hint {
      font-size: 0.85rem;
      color: var(--mute);
      transition: opacity 0.4s;
    }
    .svc__hint.is-gone {
      opacity: 0;
    }
  }
  @media (max-width: 900px) {
    .svc__head {
      justify-items: center;
      text-align: center;
    }
    .svc__title,
    .svc__lede {
      margin-inline: auto;
    }
  }
</style>
