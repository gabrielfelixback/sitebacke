---
import { FRONTS } from '../data/content';
import { asset } from '../lib/url';
const media: Record<string, { img: string; video?: string; pos?: string }> = {
  // cada frente aceita foto (img) ou vídeo em loop (video + img como capa).
  // fotos de banco (Unsplash) só até a Backe mandar o vídeo próprio de cada frente
  estrategia: { img: 'fotos/estrategia-backe.webp', pos: '60% 50%' },
  demanda: { img: 'video/frente-demanda-poster.jpg', video: 'video/frente-demanda.mp4' },
  marca: { img: 'fotos/marca-backe.webp', pos: '78% 50%' },
  imagem: { img: 'video/drone-poster.jpg', video: 'video/drone-loop.mp4' },
};
const firstSentence = (t: string) => t.split(/(?<=\.)\s/)[0];
---
<section class="svc" id="servicos" aria-labelledby="svc-title">
  <div class="wrap">
    <header class="svc__head">
      <h2 class="svc__title" id="svc-title">Um time, quatro frentes e um plano só.</h2>
      <p class="svc__lede">
        Você não precisa de mais um fornecedor de posts ou anúncios. Precisa de uma equipe que estruture o marketing
        inteiro e faça cada frente trabalhar a favor da outra.
      </p>
    </header>

    <div class="stack" data-stack>
      {
        FRONTS.map((f, i) => (
          <article class={`fcard fcard--${f.id}`} style={`--i:${i}`} data-fcard aria-labelledby={`fc-${f.id}`}>
            <div class="fcard__body">
              <p class="fcard__count">
                Frente {i + 1} de {FRONTS.length}
              </p>
              <h3 class="fcard__name" id={`fc-${f.id}`}>
                {f.name}
              </h3>
              <p class="fcard__promise">{f.promise}</p>
              <ul class="fcard__list">
                {f.services.map((s) => (
                  <li>
                    <a class="srv" href="#diagnostico" data-interest={s.title} data-cta="servico">
                      <span class="srv__t">{s.title}</span>
                      <span class="srv__d">{firstSentence(s.impact)}</span>
                      <span class="srv__tags">{s.deliverables.map((d) => <span>{d}</span>)}</span>
                      <span class="srv__go" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div class="fcard__media" aria-hidden="true">
              {media[f.id].video ? (
                <video class="fcard__video" muted loop playsinline preload="none" poster={asset(media[f.id].img)} data-autoplay>
                  <source src={asset(media[f.id].video!)} type="video/mp4" />
                </video>
              ) : (
                <img src={asset(media[f.id].img)} alt="" loading="lazy" decoding="async" class="fcard__photo" style={media[f.id].pos ? `object-position:${media[f.id].pos}` : undefined} />
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .svc {
    position: relative;
    background: #000;
    padding-block: clamp(6rem, 12vw, 10rem) clamp(4rem, 8vw, 6rem);
  }
  .svc__head {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 32px 64px;
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .svc__title {
    font-family: var(--f-display);
    font-size: clamp(2.6rem, 6vw, 6rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-variation-settings: 'opsz' 96;
    max-width: 12ch;
  }
  .svc__lede {
    color: var(--mute);
    font-size: 1.1rem;
    max-width: 36ch;
  }

  .stack {
    display: grid;
    gap: 24px;
  }
  .fcard {
    position: sticky;
    top: calc(var(--header-h) + 20px + var(--i) * 18px);
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    min-height: min(calc(var(--vh, 1svh) * 78), 720px);
    border-radius: 36px;
    overflow: hidden;
    background:
      radial-gradient(70% 90% at 100% 100%, rgb(254 67 77 / 0.22), transparent 60%),
      radial-gradient(60% 70% at 85% 20%, rgb(241 143 52 / 0.12), transparent 60%),
      linear-gradient(160deg, #1b1918 0%, #0e0d0c 70%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      0 -30px 80px -30px rgb(0 0 0 / 0.9);
    transform-origin: 50% 0;
    will-change: transform;
  }
  .fcard__body {
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 4vw, 56px);
  }
  .fcard__count {
    font-size: 0.9rem;
    color: var(--mute);
  }
  .fcard__name {
    margin-top: 18px;
    font-family: var(--f-display);
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.05em;
    font-variation-settings: 'opsz' 96;
    background: linear-gradient(180deg, #fff 40%, #ffc7a3 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .fcard__promise {
    margin-top: 16px;
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    color: #d6d1cb;
  }
  .fcard__list {
    margin-top: auto;
    padding-top: 36px;
    display: grid;
  }
  .srv {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 40px;
    grid-template-areas: 't go' 'd go' 'g g';
    gap: 4px 16px;
    align-items: center;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .srv__t {
    grid-area: t;
    font-weight: 600;
    font-size: 1.05rem;
    transition: color 0.3s;
  }
  .srv__d {
    grid-area: d;
    font-size: 0.92rem;
    color: var(--mute);
  }
  .srv__go {
    grid-area: go;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: background 0.35s, box-shadow 0.35s, transform 0.5s var(--ease-out);
  }
  .srv__go svg {
    width: 16px;
    transform: rotate(calc(var(--cut) * -1));
  }
  .srv:hover .srv__t {
    color: var(--orange);
  }
  .srv:hover .srv__go {
    background: var(--orange);
    color: var(--black);
    box-shadow: none;
    transform: translateX(4px);
  }
  .fcard__media {
    position: relative;
    display: grid;
    place-items: center;
    padding: 24px;
  }
  .fcard__media {
    overflow: hidden;
  }
  .fcard__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 26px;
    filter: saturate(0.9) contrast(1.05);
    transition: transform 1.4s var(--ease-out);
  }
  .fcard__media::after {
    /* a luz da marca por cima da foto, para ela conversar com o resto do site */
    content: '';
    position: absolute;
    inset: 14px;
    border-radius: 26px;
    pointer-events: none;
    background:
      linear-gradient(180deg, transparent 45%, rgb(14 13 12 / 0.55)),
      radial-gradient(80% 60% at 100% 100%, rgb(254 67 77 / 0.28), transparent 70%);
  }
  .srv__tags {
    grid-area: g;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .srv__tags span {
    font-size: 0.78rem;
    padding: 4px 10px;
    border-radius: 999px;
    color: #d6d1cb;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .fcard:hover .fcard__photo {
    transform: scale(1.03);
  }
  .fcard__media {
    padding: 14px;
  }
  .fcard--imagem .fcard__media {
    padding: 14px;
  }
  .fcard__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 26px;
  }

  @media (max-width: 900px) {
    .svc__head {
      grid-template-columns: 1fr;
    }
    .fcard {
      position: relative;
      top: auto;
      grid-template-columns: 1fr;
      min-height: 0;
      border-radius: 28px;
    }
    .fcard__media {
      order: -1;
      display: block;
      height: 64vw;
      padding: 16px 16px 0;
    }
    .fcard__media img {
      height: 100%;
      max-height: none;
    }
    .fcard--imagem .fcard__media {
      padding: 10px 10px 0;
    }
    .fcard__list {
      padding-top: 24px;
    }
  }
</style>
